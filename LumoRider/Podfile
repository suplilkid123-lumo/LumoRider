platform :ios, '15.0'
project 'RealLumo.xcodeproj'

target 'RealLumo' do
  use_frameworks!

  # Google Sign-In / AppAuth
  pod 'AppAuth'

  # Google Maps (only if you actually use it)
  pod 'GoogleMaps'
  pod 'Google-Maps-iOS-Utils'

  # Stripe (uncomment only if you're really using Stripe)
  # pod 'Stripe'

  target 'RealLumoTests' do
    inherit! :search_paths
  end

  target 'RealLumoUITests' do
    inherit! :search_paths
  end
end

# CocoaPods 1.16.2 emits `realpath -mq` in generated shell scripts. The macOS
# BSD `realpath` utility does not support those GNU options, so normalize the
# diagnostic-only error handler after every pod installation.
post_install do |installer|
  support_scripts = File.join(installer.sandbox.root, 'Target Support Files', '**', '*.sh')

  Dir.glob(support_scripts).each do |script_path|
    script = File.read(script_path)
    next unless script.include?('realpath -mq "${0}"')

    File.write(
      script_path,
      script.gsub(
        'echo "$(realpath -mq "${0}"):$1: error: Unexpected failure"',
        'echo "${0}:$1: error: Unexpected failure"'
      )
    )
  end
end
